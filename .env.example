# NASA FIRMS API key — get one free at https://firms.modaps.eosdis.nasa.gov/api/
FIRMS_KEY=your_firms_api_key_here

# Mapbox GL JS access token — https://account.mapbox.com/
MAPBOX_TOKEN=pk.your_mapbox_token_here

# ── Email Alerting (optional) ──────────────────────────────────────────────
# If set, the app sends an email whenever a new tornado warning, hurricane
# warning, or M5.0+ earthquake is detected during a data refresh cycle.
# Both variables must be set for alerting to activate.
#
# SendGrid API key — free tier supports 100 emails/day
# https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Address that alert emails are delivered to
ALERT_EMAIL=you@example.com

# Server port (set automatically by Render, only needed for local overrides)
# PORT=8050
